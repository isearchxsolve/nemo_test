# OpenPath configuration. Copy this file to `.env` and fill in values.

# Target app
BASE_URL=http://localhost:5173

# Credentials for the app under test (optional - skip auth tests if unset)
TEST_USERNAME=demo
TEST_PASSWORD=change-me
LOGIN_SELECTOR_USER=input[name="username"]
LOGIN_SELECTOR_PASS=input[name="password"]
LOGIN_SELECTOR_SUBMIT=button[type="submit"]

# LLM orchestration (OpenAI-compatible). Works with OpenAI, OpenRouter,
# NVIDIA NIM, local vLLM/ollama with the OpenAI shim, etc.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=meta/llama-3.1-8b-instruct
# Optional: max turns for the AI computer-use loop per natural-language step.
LLM_MAX_STEPS=8
# Optional: HTTP timeout (seconds) for LLM calls.
LLM_TIMEOUT=30
